# ─── Client (Vite) environment variables ──────────────────────────────────────
# In development, the Vite proxy forwards /api to localhost:5000 automatically.
# In production (Vercel), set this to your deployed API URL if running the server
# separately from the frontend (e.g. a Railway / Render Express server).
# Leave empty if the API is co-deployed with the frontend on the same Vercel project.
VITE_API_URL=

# ─── Server environment variables ─────────────────────────────────────────────
# Port the Express server listens on (defaults to 5000 if not set)
PORT=5000
